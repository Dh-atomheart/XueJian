# ========================================
# 学笺 (XueJian) .gitignore
# ========================================

# ----------------------------------------
# Editor / IDE
# ----------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ----------------------------------------
# OS Generated Files
# ----------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----------------------------------------
# Logs
# ----------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------
# Dependencies
# ----------------------------------------
node_modules/
.pnpm-store/

# ----------------------------------------
# Build Outputs
# ----------------------------------------
dist/
dist-ssr/
build/
out/
*.local

# ----------------------------------------
# AI assistant
# ----------------------------------------
.codex/
.claude/
examples/
docs/

# ----------------------------------------
# Cache & Temp Files
# ----------------------------------------
.cache/
.vite/
.vite-temp/
*.tsbuildinfo
.turbo/
.eslintcache

# ----------------------------------------
# Environment & Secrets (CRITICAL)
# ----------------------------------------
# Environment variables - may contain API keys, secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# API Keys & Credentials
*.pem
*.key
*.crt
secrets/
credentials/
.creds

# ----------------------------------------
# Database Files (User Data)
# ----------------------------------------
# SQLite databases - contain user's learning data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Do not ignore database migration files
!**/migrations/*.sql
!**/migrations/*.ts

# ----------------------------------------
# Stronghold Files (Encrypted Secrets Storage)
# ----------------------------------------
# Stronghold vault files - contain encrypted API keys
*.stronghold
*.stronghold.backup
stronghold/

# ----------------------------------------
# User Data & Documents
# ----------------------------------------
# Uploaded PDFs and user documents
uploads/
documents/
user-data/
data/

# Generated files
generated/
exports/

# ----------------------------------------
# Test & Coverage
# ----------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ----------------------------------------
# Rust / Cargo
# ----------------------------------------
# Cargo build artifacts
target/
**/target/

# Cargo lock files for libraries (keep for applications)
# Cargo.lock

# Rust backup files
**/*.rs.bk
*.rlib

# ----------------------------------------
# Tauri
# ----------------------------------------
# Tauri generated files
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
src-tauri/Cargo.lock

# Tauri build outputs
src-tauri/bundle/

# ----------------------------------------
# Electron (if any legacy)
# ----------------------------------------
electron-builder.yml
electron/

# ----------------------------------------
# Package Manager Locks (keep one)
# ----------------------------------------
# Keep package-lock.json, yarn.lock, or pnpm-lock.yaml as needed
# pnpm-lock.yaml

# ----------------------------------------
# Misc Generated Files
# ----------------------------------------
# Animation & Podcast generated content
animations/
podcasts/
audio/

# Embedding vectors cache
embeddings/
*.embeddings

# ----------------------------------------
# Debug & Profiling
# ----------------------------------------
*.cpuprofile
*.heapsnapshot
.pnp.*

# ----------------------------------------
# Temporary Files
# ----------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*~

# ----------------------------------------
# Platform Specific
# ----------------------------------------
# Windows
*.exe
*.dll
*.so
*.dylib

# macOS
*.dmg

# Linux
*.AppImage
*.deb
*.rpm
